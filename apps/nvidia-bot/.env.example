# Clé API NVIDIA NIM - obtenue sur https://build.nvidia.com
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modèle NVIDIA NIM à utiliser
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Personnalité du bot (optionnel)
BOT_NAME=Assistant WhatsApp

# Préfixe de commande (optionnel, laisser vide pour répondre à tout)
# BOT_PREFIX=!
